title: $:/plugins/mblackman/coffee-tracker/macros/library
type: text/vnd.tiddlywiki
tags: $:/tags/Macro

\function ct.bag-instance-avg(bagInstance)
[all[tiddlers]tag[BrewLog]coffee-bag-instance<bagInstance>get[overall-rating]!is[blank]] :and[average[]fixed[1]]
\end

\function ct.coffee-type-avg(coffeeType)
[all[tiddlers]tag[CoffeeBagInstance]coffee-bag<coffeeType>] :map[ct.bag-instance-avg<currentTiddler>] :filter[!is[blank]] :and[average[]fixed[1]]
\end

\function ct.bag-last-brew(bagInstance)
[all[tiddlers]tag[BrewLog]coffee-bag-instance<bagInstance>sort[created]sort[brew-time]sort[brew-date]last[]]
\end

\function ct.bag-best-brew(bagInstance)
[<bagInstance>bag-best-brew[]]
\end

\function ct.water-ratio(dose, water)
[<water>compare:number:gt[0]] :filter[<dose>compare:number:gt[0]] :and[divide<dose>fixed[1]]
\end

\function ct.yield-ratio(dose, yield)
[<yield>compare:number:gt[0]] :filter[<dose>compare:number:gt[0]] :and[divide<dose>fixed[1]]
\end

\procedure coffee-freshness-badge(roastDate:"", bag:"")
<$let
    targetBag={{{ [<bag>!is[blank]] ~[<currentTiddler>tag[CoffeeBagInstance]] }}}
    roast-days={{{ [<targetBag>!is[blank]days-since-roast[roast-date]] ~[<roastDate>!is[blank]days-since-roast[]] }}}
    peak-start={{$:/plugins/mblackman/coffee-tracker/config/freshness/peak-start}}
    peak-end={{$:/plugins/mblackman/coffee-tracker/config/freshness/peak-end}}
    optimal-end={{$:/plugins/mblackman/coffee-tracker/config/freshness/optimal-end}}
>
<%if [<targetBag>tag[Frozen]] %>
    <span class="ct-tag ct-badge-frozen" title="Coffee is stored in the freezer (aging paused)">❄️ Frozen<%if [<roast-days>!is[blank]] %> • <$text text=<<roast-days>>/>d<%endif%></span>
<%elseif [<roast-days>!is[blank]] %>
    <%if [<roast-days>compare:number:lt<peak-start>] %>
        <span class="ct-tag ct-badge-info" title="Coffee is very fresh and still degassing">Fresh • <$text text=<<roast-days>>/>d</span>
    <%elseif [<roast-days>compare:number:gteq<peak-start>compare:number:lt<peak-end>] %>
        <span class="ct-tag ct-badge-success" title="Optimal flavor development window">Peak • <$text text=<<roast-days>>/>d</span>
    <%elseif [<roast-days>compare:number:gteq<peak-end>compare:number:lt<optimal-end>] %>
        <span class="ct-tag ct-badge-warning" title="Well-integrated flavors, still enjoyable">Good • <$text text=<<roast-days>>/>d</span>
    <%else%>
        <span class="ct-tag ct-badge-danger" title="Past optimal freshness window">Aging • <$text text=<<roast-days>>/>d</span>
    <%endif%>
<%endif%>
</$let>
\end

\procedure coffee-stat-card(value, label)
<div class="ct-stat-card">
    <div class="ct-stat-value"><$text text=<<value>>/></div>
    <div class="ct-stat-label"><$text text=<<label>>/></div>
</div>
\end

\procedure create-brew-log-actions(coffee-bag-instance:"")
<$let newTitle=<<now "Brew Log: YYYY-0MM-0DD 0hh:0mm">>>
<$action-createtiddler
    $basetitle=<<newTitle>>
    tags="BrewLog"
    coffee-bag-instance=<<coffee-bag-instance>>
    brew-date=<<now "YYYY-0MM-0DD">>
    brew-time=<<now "0hh:0mm">>
    $savetitle="$:/temp/created-brew-log"
/>
<$action-setfield $tiddler={{{ [[$:/state/coffee-tracker/edit/]addsuffix{$:/temp/created-brew-log}] }}} text="yes"/>
<$action-navigate $to={{$:/temp/created-brew-log}}/>
<$action-deletetiddler $tiddler="$:/temp/created-brew-log"/>
</$let>
\end

\procedure create-brew-log-from-last(lastBrew)
<$let
    newTitle=<<now "Brew Log: YYYY-0MM-0DD 0hh:0mm">>
    coffee-bag={{{ [<lastBrew>get[coffee-bag-instance]] }}}
    dose={{{ [<lastBrew>get[dose]] }}}
    water={{{ [<lastBrew>get[water]] }}}
    yield={{{ [<lastBrew>get[yield]] }}}
    water-temp={{{ [<lastBrew>get[water-temp]] }}}
    grind-size={{{ [<lastBrew>get[grind-size]] }}}
    brewer={{{ [<lastBrew>get[brewer]] }}}
    grinder={{{ [<lastBrew>get[grinder]] }}}
    brew-method={{{ [<lastBrew>get[brew-method]] }}}
>
<$action-createtiddler
    $basetitle=<<newTitle>>
    tags="BrewLog"
    coffee-bag-instance=<<coffee-bag>>
    brew-date=<<now "YYYY-0MM-0DD">>
    brew-time=<<now "0hh:0mm">>
    dose=<<dose>>
    water=<<water>>
    yield=<<yield>>
    water-temp=<<water-temp>>
    grind-size=<<grind-size>>
    brewer=<<brewer>>
    grinder=<<grinder>>
    brew-method=<<brew-method>>
    $savetitle="$:/temp/created-brew-log"
/>
<$action-setfield $tiddler={{{ [[$:/state/coffee-tracker/edit/]addsuffix{$:/temp/created-brew-log}] }}} text="yes"/>
<$action-navigate $to={{$:/temp/created-brew-log}}/>
<$action-deletetiddler $tiddler="$:/temp/created-brew-log"/>
</$let>
\end

\procedure copy-brew-log-settings(sourceBrew, targetBrew)
<$let
    dose={{{ [<sourceBrew>get[dose]] }}}
    water={{{ [<sourceBrew>get[water]] }}}
    yield={{{ [<sourceBrew>get[yield]] }}}
    water-temp={{{ [<sourceBrew>get[water-temp]] }}}
    grind-size={{{ [<sourceBrew>get[grind-size]] }}}
    brewer={{{ [<sourceBrew>get[brewer]] }}}
    grinder={{{ [<sourceBrew>get[grinder]] }}}
    brew-method={{{ [<sourceBrew>get[brew-method]] }}}
>
<$action-setfield
    $tiddler=<<targetBrew>>
    dose=<<dose>>
    water=<<water>>
    yield=<<yield>>
    water-temp=<<water-temp>>
    grind-size=<<grind-size>>
    brewer=<<brewer>>
    grinder=<<grinder>>
    brew-method=<<brew-method>>
/>
</$let>
\end

\procedure unfreeze-coffee-bag-actions(bag)
<$let
    targetBag={{{ [<bag>!is[blank]else<currentTiddler>] }}}
    frozenDate={{{ [<targetBag>get[frozen-date]] }}}
    sessionDays={{{ [<frozenDate>!is[blank]days-since-roast[]] ~[[0]] }}}
    prevFrozenDays={{{ [<targetBag>get[frozen-days]!is[blank]else[0]] }}}
    newFrozenDays={{{ [<prevFrozenDays>add<sessionDays>] }}}
>
<$action-listops $tiddler=<<targetBag>> $tags="-Frozen"/>
<%if [<frozenDate>!is[blank]] %>
    <$action-setfield $tiddler=<<targetBag>> frozen-days=<<newFrozenDays>>/>
    <$action-deletefield $tiddler=<<targetBag>> $field="frozen-date"/>
<%endif%>
</$let>
\end

\procedure finish-coffee-bag-actions(bag)
<$let targetBag={{{ [<bag>!is[blank]else<currentTiddler>] }}}>
<%if [<targetBag>tag[Frozen]] %>
    <$macrocall $name="unfreeze-coffee-bag-actions" bag=<<targetBag>>/>
<%endif%>
<$action-listops $tiddler=<<targetBag>> $tags="+[append[Finished]] -Frozen"/>
</$let>
\end
