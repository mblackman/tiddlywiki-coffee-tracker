title: $:/plugins/mblackman/coffee-tracker/macros/library
type: text/vnd.tiddlywiki
tags: $:/tags/Macro

\function ct.bag-instance-avg(bagInstance)
[all[tiddlers]tag[BrewLog]coffee-bag-instance<bagInstance>get[overall-rating]!is[blank]] :and[average[]compare:number:gt[0]fixed[1]]
\end

\function ct.coffee-type-avg(coffeeType)
[all[tiddlers]tag[CoffeeBagInstance]coffee-bag<coffeeType>] :map[ct.bag-instance-avg<currentTiddler>] :filter[!is[blank]] :and[average[]compare:number:gt[0]fixed[1]]
\end

\function ct.bag-last-brew(bagInstance)
[all[tiddlers]tag[BrewLog]coffee-bag-instance<bagInstance>sort[created]sort[brew-time]sort[brew-date]last[]]
\end

\function ct.bag-best-brew(bagInstance)
[<bagInstance>bag-best-brew[]]
\end

\function ct.water-ratio(dose, water)
[<water>compare:number:gt[0]] :filter[<dose>compare:number:gt[0]] :and[divide<dose>fixed[1]]
\end

\function ct.yield-ratio(dose, yield)
[<yield>compare:number:gt[0]] :filter[<dose>compare:number:gt[0]] :and[divide<dose>fixed[1]]
\end

\function ct.grinder-total-grams(grinder)
[<grinder>grinder-total-grams[]]
\end

\function ct.grinder-total-display(grinder)
[<grinder>grinder-total-grams[]compare:number:gteq[1000]] :map[divide[1000]fixed[2]addsuffix[ kg (]addsuffix<currentTiddler>addsuffix[g)]] ~[<grinder>grinder-total-grams[]addsuffix[g]]
\end

\widget $ct.panel(title, badge:"")
<div class="ct-section-white">
    <%if [<title>!is[blank]] %>
        <div class="ct-flex-row ct-section-header">
            <h3 class="ct-m-0"><$text text=<<title>>/></h3>
            <%if [<badge>!is[blank]] %>
                <span class="ct-tag ct-badge-info"><$text text=<<badge>>/></span>
            <%endif%>
        </div>
    <%endif%>
    <$slot $name="ts-raw"/>
</div>
\end

\widget $ct.sensory-radar(target)
<$let
    subject={{{ [<target>!is[blank]else<currentTiddler>] }}}
    radarPoints={{{ [<subject>sensory-radar-points[]] }}}
>
<%if [<radarPoints>!is[blank]] %>
<div class="ct-radar-container">
    <svg viewBox="-20 5 300 220" class="ct-radar-svg" role="img" aria-label="6-Axis Sensory Radar Chart">
        <!-- Concentric reference hexagons (2.5, 5.0, 7.5, 10.0) -->
        <polygon points="130,43 192.4,79 192.4,151 130,187 67.6,151 67.6,79" class="ct-radar-grid-outer"/>
        <polygon points="130,61 176.8,88 176.8,142 130,169 83.2,142 83.2,88" class="ct-radar-grid"/>
        <polygon points="130,79 161.2,97 161.2,133 130,151 98.8,133 98.8,97" class="ct-radar-grid"/>
        <polygon points="130,97 145.6,106 145.6,124 130,133 114.4,124 114.4,106" class="ct-radar-grid"/>
        <!-- Axis spokes -->
        <line x1="130" y1="43" x2="130" y2="187" class="ct-radar-axis"/>
        <line x1="192.4" y1="79" x2="67.6" y2="151" class="ct-radar-axis"/>
        <line x1="192.4" y1="151" x2="67.6" y2="79" class="ct-radar-axis"/>
        <!-- Sensory polygon -->
        <polygon points=<<radarPoints>> class="ct-radar-polygon"/>
        <!-- Vertex dots -->
        <$list filter="aroma flavor acidity body sweetness aftertaste" variable="attr">
            <$let
                vx={{{ [<subject>sensory-axis-point:x<attr>] }}}
                vy={{{ [<subject>sensory-axis-point:y<attr>] }}}
            >
                <circle cx=<<vx>> cy=<<vy>> r="3.5" class="ct-radar-dot"/>
            </$let>
        </$list>
        <!-- Axis labels -->
        <text x="130" y="30" text-anchor="middle" class="ct-radar-label">Aroma (<$text text={{{ [<subject>sensory-score[aroma]else[—]] }}}/>)</text>
        <text x="200" y="78" text-anchor="start" class="ct-radar-label">Flavor (<$text text={{{ [<subject>sensory-score[flavor]else[—]] }}}/>)</text>
        <text x="200" y="156" text-anchor="start" class="ct-radar-label">Acidity (<$text text={{{ [<subject>sensory-score[acidity]else[—]] }}}/>)</text>
        <text x="130" y="206" text-anchor="middle" class="ct-radar-label">Body (<$text text={{{ [<subject>sensory-score[body]else[—]] }}}/>)</text>
        <text x="60" y="156" text-anchor="end" class="ct-radar-label">Sweetness (<$text text={{{ [<subject>sensory-score[sweetness]else[—]] }}}/>)</text>
        <text x="60" y="78" text-anchor="end" class="ct-radar-label">Aftertaste (<$text text={{{ [<subject>sensory-score[aftertaste]else[—]] }}}/>)</text>
    </svg>
</div>
<%endif%>
</$let>
\end

\procedure ct-sensory-radar(target)
<$ct.sensory-radar target=<<target>>/>
\end

\procedure ct-progression-chart(target, label:"Rating & Roast-Age Progression")
<$let
    subject={{{ [<target>!is[blank]else<currentTiddler>] }}}
    polyPoints={{{ [<subject>bag-progression-points[]] }}}
>
<%if [<polyPoints>!is[blank]] %>
<div class="ct-progression-container">
    <div class="ct-flex-row ct-mb-xs">
        <span class="ct-text-sm ct-text-bold"><$text text=<<label>>/></span>
        <span class="ct-text-sm ct-muted-text">Roast Age / Date →</span>
    </div>
    <svg viewBox="0 0 420 140" class="ct-progression-svg" role="img" aria-label=<<label>>>
        <!-- Y-axis grid lines (10, 7.5, 5.0) -->
        <line x1="35" y1="15" x2="395" y2="15" class="ct-radar-grid"/>
        <text x="28" y="19" text-anchor="end" class="ct-chart-axis-text">10</text>
        <line x1="35" y1="40" x2="395" y2="40" class="ct-radar-grid"/>
        <text x="28" y="44" text-anchor="end" class="ct-chart-axis-text">7.5</text>
        <line x1="35" y1="65" x2="395" y2="65" class="ct-radar-grid"/>
        <text x="28" y="69" text-anchor="end" class="ct-chart-axis-text">5.0</text>
        <line x1="35" y1="115" x2="395" y2="115" class="ct-radar-grid-outer"/>
        <text x="28" y="118" text-anchor="end" class="ct-chart-axis-text">0</text>
        <!-- Trendline -->
        <polyline points=<<polyPoints>> class="ct-progression-line"/>
        <!-- Data points & Roast Age / Date X-axis ticks -->
        <$list filter="[<subject>bag-progression-points:meta[]]" variable="meta">
            <$let
                px={{{ [<meta>split[|]nth[1]] }}}
                py={{{ [<meta>split[|]nth[2]] }}}
                pRating={{{ [<meta>split[|]nth[3]] }}}
                pLabel={{{ [<meta>split[|]nth[4]] }}}
            >
                <circle cx=<<px>> cy=<<py>> r="4" class="ct-radar-dot">
                    <title><$text text=<<pLabel>>/>: ★ <$text text=<<pRating>>/>/10</title>
                </circle>
                <text x=<<px>> y="132" text-anchor="middle" class="ct-chart-axis-text"><$text text=<<pLabel>>/></text>
            </$let>
        </$list>
    </svg>
</div>
<%endif%>
</$let>
\end

\procedure coffee-freshness-badge(roastDate:"", bag:"")
<$let
    targetBag={{{ [<bag>!is[blank]] ~[<currentTiddler>tag[CoffeeBagInstance]] }}}
    roast-days={{{ [<targetBag>!is[blank]days-since-roast[roast-date]] ~[<roastDate>!is[blank]days-since-roast[]] }}}
    peak-start={{$:/plugins/mblackman/coffee-tracker/config/freshness/peak-start}}
    peak-end={{$:/plugins/mblackman/coffee-tracker/config/freshness/peak-end}}
    optimal-end={{$:/plugins/mblackman/coffee-tracker/config/freshness/optimal-end}}
>
<%if [<targetBag>tag[Frozen]] %>
    <span class="ct-tag ct-badge-frozen" title="Coffee is stored in the freezer (aging paused)">❄️ Frozen<%if [<roast-days>!is[blank]] %> • <$text text=<<roast-days>>/>d<%endif%></span>
<%elseif [<roast-days>!is[blank]] %>
    <%if [<roast-days>compare:number:lt<peak-start>] %>
        <span class="ct-tag ct-badge-info" title="Coffee is very fresh and still degassing">Fresh • <$text text=<<roast-days>>/>d</span>
    <%elseif [<roast-days>compare:number:gteq<peak-start>compare:number:lt<peak-end>] %>
        <span class="ct-tag ct-badge-success" title="Optimal flavor development window">Peak • <$text text=<<roast-days>>/>d</span>
    <%elseif [<roast-days>compare:number:gteq<peak-end>compare:number:lt<optimal-end>] %>
        <span class="ct-tag ct-badge-warning" title="Well-integrated flavors, still enjoyable">Good • <$text text=<<roast-days>>/>d</span>
    <%else%>
        <span class="ct-tag ct-badge-danger" title="Past optimal freshness window">Aging • <$text text=<<roast-days>>/>d</span>
    <%endif%>
<%endif%>
</$let>
\end

\procedure coffee-stat-card(value, label)
<div class="ct-stat-card">
    <div class="ct-stat-value"><$text text=<<value>>/></div>
    <div class="ct-stat-label"><$text text=<<label>>/></div>
</div>
\end

\widget $ct.metric-stepper(field, label, step:"1", defaultVal:"18", min:"0", max:"9999", placeholder:"")
<div class="ct-metric-item">
    <label class="ct-label"><$text text=<<label>>/></label>
    <div class="ct-stepper-control">
        <$button class="tc-btn-invisible ct-stepper-btn" aria-label=`Decrease $(label)$`>
            <$let
                curVal={{{ [all[current]get<field>] }}}
                negOperand={{{ [[-]] [<step>] [[|]] [<defaultVal>] [[|]] [<min>] [[|]] [<max>] +[join[]] }}}
                nextVal={{{ [<curVal>step-metric<negOperand>] }}}
            >
                <$action-setfield $field=<<field>> $value=<<nextVal>>/>
            </$let>
            −
        </$button>
        <$edit-text field=<<field>> tag="input" inputmode="decimal" size="5" placeholder=<<placeholder>> class="tc-edit-texteditor ct-metric-input"/>
        <$button class="tc-btn-invisible ct-stepper-btn" aria-label=`Increase $(label)$`>
            <$let
                curVal={{{ [all[current]get<field>] }}}
                posOperand={{{ [<step>] [[|]] [<defaultVal>] [[|]] [<min>] [[|]] [<max>] +[join[]] }}}
                nextVal={{{ [<curVal>step-metric<posOperand>] }}}
            >
                <$action-setfield $field=<<field>> $value=<<nextVal>>/>
            </$let>
            +
        </$button>
    </div>
</div>
\end

\procedure ct-tasting-note-pills(coffeeBag, limit:"6")
<%if [<coffeeBag>!is[blank]tasting-note-tokens[]limit[1]] %>
    <div class="ct-flavor-pills">
        <$list filter="[<coffeeBag>tasting-note-tokens[]limit<limit>]" variable="noteToken">
            <span class="ct-flavor-pill"><$text text=<<noteToken>>/></span>
        </$list>
    </div>
<%endif%>
\end

\procedure create-brew-log-actions(coffee-bag-instance:"")
<$let
    newTitle=<<now "Brew Log: YYYY-0MM-0DD 0hh:0mm">>
    lastGlobalBrew={{{ [all[tiddlers]tag[BrewLog]sort[created]sort[brew-time]sort[brew-date]last[]] }}}
    lastGlobalBag={{{ [<lastGlobalBrew>get[coffee-bag-instance]] :filter[!tag[Finished]] }}}
    fallbackActiveBag={{{ [all[tiddlers]tag[CoffeeBagInstance]!tag[Finished]sort[purchase-date]last[]] }}}
    effectiveBag={{{ [<coffee-bag-instance>!is[blank]] ~[<lastGlobalBag>!is[blank]] ~[<fallbackActiveBag>] }}}
    bagLastBrew={{{ [<effectiveBag>!is[blank]then[ct.bag-last-brew<effectiveBag>]] }}}
    singleBrewer={{{ [all[tiddlers]tag[Equipment]equipment-type[Brewer]count[]match[1]then[all[tiddlers]tag[Equipment]equipment-type[Brewer]]] }}}
    singleGrinder={{{ [all[tiddlers]tag[Equipment]equipment-type[Grinder]count[]match[1]then[all[tiddlers]tag[Equipment]equipment-type[Grinder]]] }}}
    defaultBrewer={{{ [<bagLastBrew>get[brewer]!is[blank]] ~[<lastGlobalBrew>get[brewer]!is[blank]] ~[<singleBrewer>] }}}
    defaultGrinder={{{ [<bagLastBrew>get[grinder]!is[blank]] ~[<lastGlobalBrew>get[grinder]!is[blank]] ~[<singleGrinder>] }}}
    singleMethod={{{ [<defaultBrewer>get[brew-methods]enlist-input[]count[]match[1]then<defaultBrewer>get[brew-methods]enlist-input[]] }}}
    defaultMethod={{{ [<bagLastBrew>get[brew-method]!is[blank]] ~[<singleMethod>!is[blank]] ~[<lastGlobalBrew>get[brew-method]!is[blank]] }}}
    defaultDose={{{ [<bagLastBrew>get[dose]] }}}
    defaultWater={{{ [<bagLastBrew>get[water]] }}}
    defaultYield={{{ [<bagLastBrew>get[yield]] }}}
    defaultTemp={{{ [<bagLastBrew>get[water-temp]] }}}
    defaultGrind={{{ [<bagLastBrew>get[grind-size]] }}}
>
<$action-createtiddler
    $basetitle=<<newTitle>>
    tags="BrewLog"
    coffee-bag-instance=<<effectiveBag>>
    brew-date=<<now "YYYY-0MM-0DD">>
    brew-time=<<now "0hh:0mm">>
    brewer=<<defaultBrewer>>
    grinder=<<defaultGrinder>>
    brew-method=<<defaultMethod>>
    dose=<<defaultDose>>
    water=<<defaultWater>>
    yield=<<defaultYield>>
    water-temp=<<defaultTemp>>
    grind-size=<<defaultGrind>>
    $savetitle="$:/temp/created-brew-log"
/>
<$action-setfield $tiddler={{{ [[$:/state/coffee-tracker/edit/]addsuffix{$:/temp/created-brew-log}] }}} text="yes"/>
<$action-navigate $to={{$:/temp/created-brew-log}}/>
<$action-deletetiddler $tiddler="$:/temp/created-brew-log"/>
</$let>
\end

\procedure create-brew-log-from-last(lastBrew)
<$let
    newTitle=<<now "Brew Log: YYYY-0MM-0DD 0hh:0mm">>
    coffee-bag={{{ [<lastBrew>get[coffee-bag-instance]] }}}
    dose={{{ [<lastBrew>get[dose]] }}}
    water={{{ [<lastBrew>get[water]] }}}
    yield={{{ [<lastBrew>get[yield]] }}}
    water-temp={{{ [<lastBrew>get[water-temp]] }}}
    grind-size={{{ [<lastBrew>get[grind-size]] }}}
    brewer={{{ [<lastBrew>get[brewer]] }}}
    grinder={{{ [<lastBrew>get[grinder]] }}}
    brew-method={{{ [<lastBrew>get[brew-method]] }}}
>
<$action-createtiddler
    $basetitle=<<newTitle>>
    tags="BrewLog"
    coffee-bag-instance=<<coffee-bag>>
    brew-date=<<now "YYYY-0MM-0DD">>
    brew-time=<<now "0hh:0mm">>
    dose=<<dose>>
    water=<<water>>
    yield=<<yield>>
    water-temp=<<water-temp>>
    grind-size=<<grind-size>>
    brewer=<<brewer>>
    grinder=<<grinder>>
    brew-method=<<brew-method>>
    $savetitle="$:/temp/created-brew-log"
/>
<$action-setfield $tiddler={{{ [[$:/state/coffee-tracker/edit/]addsuffix{$:/temp/created-brew-log}] }}} text="yes"/>
<$action-navigate $to={{$:/temp/created-brew-log}}/>
<$action-deletetiddler $tiddler="$:/temp/created-brew-log"/>
</$let>
\end

\procedure copy-brew-log-settings(sourceBrew, targetBrew)
<$let
    dose={{{ [<sourceBrew>get[dose]] }}}
    water={{{ [<sourceBrew>get[water]] }}}
    yield={{{ [<sourceBrew>get[yield]] }}}
    water-temp={{{ [<sourceBrew>get[water-temp]] }}}
    grind-size={{{ [<sourceBrew>get[grind-size]] }}}
    brewer={{{ [<sourceBrew>get[brewer]] }}}
    grinder={{{ [<sourceBrew>get[grinder]] }}}
    brew-method={{{ [<sourceBrew>get[brew-method]] }}}
>
<$action-setfield
    $tiddler=<<targetBrew>>
    dose=<<dose>>
    water=<<water>>
    yield=<<yield>>
    water-temp=<<water-temp>>
    grind-size=<<grind-size>>
    brewer=<<brewer>>
    grinder=<<grinder>>
    brew-method=<<brew-method>>
/>
</$let>
\end

\procedure unfreeze-coffee-bag-actions(bag)
<$let
    targetBag={{{ [<bag>!is[blank]else<currentTiddler>] }}}
    frozenDate={{{ [<targetBag>get[frozen-date]] }}}
    sessionDays={{{ [<frozenDate>!is[blank]days-since-roast[]] ~[[0]] }}}
    prevFrozenDays={{{ [<targetBag>get[frozen-days]!is[blank]else[0]] }}}
    newFrozenDays={{{ [<prevFrozenDays>add<sessionDays>] }}}
>
<$action-listops $tiddler=<<targetBag>> $tags="-Frozen"/>
<%if [<frozenDate>!is[blank]] %>
    <$action-setfield $tiddler=<<targetBag>> frozen-days=<<newFrozenDays>>/>
    <$action-deletefield $tiddler=<<targetBag>> $field="frozen-date"/>
<%endif%>
</$let>
\end

\procedure finish-coffee-bag-actions(bag)
<$let targetBag={{{ [<bag>!is[blank]else<currentTiddler>] }}}>
<%if [<targetBag>tag[Frozen]] %>
    <$macrocall $name="unfreeze-coffee-bag-actions" bag=<<targetBag>>/>
<%endif%>
<$action-listops $tiddler=<<targetBag>> $tags="+[append[Finished]] -Frozen"/>
</$let>
\end
