title: $:/plugins/mblackman/coffee-tracker/ui/sidebar-tab
tags: $:/tags/SideBar
caption: Coffee
description: "Access the Coffee Tracker Dashboard"

<div class="ct-sidebar-section">
<$link to="$:/plugins/mblackman/coffee-tracker/ui/dashboard" class="ct-sidebar-link">☕ Dashboard</$link>
</div>

<div class="ct-sidebar-section">
<$link to="$:/plugins/mblackman/coffee-tracker/ui/analytics" style="font-weight: bold;">📊 Insights & Analytics</$link>
</div>

<div class="ct-sidebar-section">
<$link to="$:/plugins/mblackman/coffee-tracker/ui/all-lists" style="font-weight: bold;">📋 Browse All</$link>
</div>

<hr>

<!-- Contextual Actions -->
<h4 class="ct-sidebar-heading">Actions</h4>
<div class="ct-sidebar-actions">
    <!-- Quick log for last used coffee -->
    <$let
        lastBrew={{{ [tag[BrewLog]sort[created]sort[brew-time]sort[brew-date]last[]] }}}
        lastBag={{{ [<lastBrew>get[coffee-bag-instance]] }}}
    >
    <%if [<lastBag>!is[blank]!tag[Finished]] %>
        <$button class="tc-btn-invisible ct-sidebar-button ct-sidebar-button-highlight" aria-label="Quick log brew for last used coffee with previous settings">
            <$macrocall $name="create-brew-log-from-last" lastBrew=<<lastBrew>>/>
            ⚡ Log Again: <$view tiddler=<<lastBag>> field="title"/>
        </$button>
    <%endif%>
    </$let>

    <!-- Standard actions -->
    <$button class="tc-btn-invisible ct-sidebar-button" aria-label="Log a new brew">
        <<create-brew-log-actions>>
        + Log Brew
    </$button>
    <$button class="tc-btn-invisible ct-sidebar-button" aria-label="Purchase a new coffee bag">
        <$action-setfield $tiddler="$:/temp/new-coffee-bag-instance" purchase-date=<<now 'YYYY-0MM-0DD'>>/>
        <$action-sendmessage $message="tm-modal" $param="$:/plugins/mblackman/coffee-tracker/modal/coffee-bag-instance"/>
        + New Bag
    </$button>
</div>

<hr>

<!-- Alerts & Reminders -->
<h4 class="ct-sidebar-heading">Active Coffee</h4>
<div class="ct-sidebar-alerts">
<$let
    peakStart={{$:/plugins/mblackman/coffee-tracker/config/freshness/peak-start}}
    peakEnd={{$:/plugins/mblackman/coffee-tracker/config/freshness/peak-end}}
    optimalEnd={{$:/plugins/mblackman/coffee-tracker/config/freshness/optimal-end}}
    agingFilter="[days-since-roast[roast-date]compare:number:gteq<optimalEnd>]"
    goodFilter="[days-since-roast[roast-date]compare:number:gteq<peakEnd>compare:number:lt<optimalEnd>]"
    peakFilter="[days-since-roast[roast-date]compare:number:gteq<peakStart>compare:number:lt<peakEnd>]"
    freshFilter="[days-since-roast[roast-date]compare:number:lt<peakStart>]"
>
    <!-- Coffees in peak freshness window (7-21 days) -->
    <%if [tag[CoffeeBagInstance]!tag[Finished]!tag[Frozen]has[roast-date]] :filter[subfilter<peakFilter>] +[limit[1]] %>
        <div class="ct-sidebar-alert ct-alert-success">
            <div class="ct-sidebar-alert-title">☕ At Peak Freshness</div>
            <$list filter="[tag[CoffeeBagInstance]!tag[Finished]!tag[Frozen]has[roast-date]] :filter[subfilter<peakFilter>]" variable="bag">
                <$let days={{{ [<bag>days-since-roast[roast-date]] }}}>
                    <div class="ct-sidebar-alert-item">
                        <$link to=<<bag>>><$view tiddler=<<bag>> field="title"/></$link>
                        <span class="ct-sidebar-alert-detail">(<<days>>d)</span>
                    </div>
                </$let>
            </$list>
        </div>
    <%endif%>

    <!-- Very fresh coffees (degassing, < 7 days) -->
    <%if [tag[CoffeeBagInstance]!tag[Finished]!tag[Frozen]has[roast-date]] :filter[subfilter<freshFilter>] +[limit[1]] %>
        <div class="ct-sidebar-alert ct-alert-info">
            <div class="ct-sidebar-alert-title">✨ Very Fresh (Degassing)</div>
            <$list filter="[tag[CoffeeBagInstance]!tag[Finished]!tag[Frozen]has[roast-date]] :filter[subfilter<freshFilter>]" variable="bag">
                <$let days={{{ [<bag>days-since-roast[roast-date]] }}}>
                    <div class="ct-sidebar-alert-item">
                        <$link to=<<bag>>><$view tiddler=<<bag>> field="title"/></$link>
                        <span class="ct-sidebar-alert-detail">(<<days>>d)</span>
                    </div>
                </$let>
            </$list>
        </div>
    <%endif%>

    <!-- Coffees still good (21-60 days) -->
    <%if [tag[CoffeeBagInstance]!tag[Finished]!tag[Frozen]has[roast-date]] :filter[subfilter<goodFilter>] +[limit[1]] %>
        <div class="ct-sidebar-alert ct-alert-info">
            <div class="ct-sidebar-alert-title">👍 Still Good</div>
            <$list filter="[tag[CoffeeBagInstance]!tag[Finished]!tag[Frozen]has[roast-date]] :filter[subfilter<goodFilter>]" variable="bag">
                <$let days={{{ [<bag>days-since-roast[roast-date]] }}}>
                    <div class="ct-sidebar-alert-item">
                        <$link to=<<bag>>><$view tiddler=<<bag>> field="title"/></$link>
                        <span class="ct-sidebar-alert-detail">(<<days>>d)</span>
                    </div>
                </$let>
            </$list>
        </div>
    <%endif%>

    <!-- Coffees aging beyond optimal (60+ days) -->
    <%if [tag[CoffeeBagInstance]!tag[Finished]!tag[Frozen]has[roast-date]] :filter[subfilter<agingFilter>] +[limit[1]] %>
        <div class="ct-sidebar-alert ct-alert-warning">
            <div class="ct-sidebar-alert-title">⚠️ Coffee Aging</div>
            <$list filter="[tag[CoffeeBagInstance]!tag[Finished]!tag[Frozen]has[roast-date]] :filter[subfilter<agingFilter>]" variable="bag">
                <$let days={{{ [<bag>days-since-roast[roast-date]] }}}>
                    <div class="ct-sidebar-alert-item">
                        <$link to=<<bag>>><$view tiddler=<<bag>> field="title"/></$link>
                        <span class="ct-sidebar-alert-detail">(<<days>>d)</span>
                    </div>
                </$let>
            </$list>
        </div>
    <%endif%>

    <!-- Coffees stored in freezer -->
    <%if [tag[CoffeeBagInstance]!tag[Finished]tag[Frozen]limit[1]] %>
        <div class="ct-sidebar-alert ct-alert-info">
            <div class="ct-sidebar-alert-title">❄️ In Freezer</div>
            <$list filter="[tag[CoffeeBagInstance]!tag[Finished]tag[Frozen]]" variable="bag">
                <$let
                    days={{{ [<bag>days-since-roast[roast-date]] }}}
                    remGrams={{{ [<bag>remaining-bag-weight[]] }}}
                >
                    <div class="ct-sidebar-alert-item">
                        <$link to=<<bag>>><$view tiddler=<<bag>> field="title"/></$link>
                        <span class="ct-sidebar-alert-detail">
                            <%if [<days>!is[blank]] %>(<<days>>d)<%elseif [<remGrams>!is[blank]] %>(<<remGrams>>g)<%endif%>
                        </span>
                    </div>
                </$let>
            </$list>
        </div>
    <%endif%>

    <!-- Coffee bags running low (<= 45g remaining or >= 10 brews) -->
    <%if [tag[CoffeeBagInstance]!tag[Finished]bag-running-low[45]limit[1]] %>
        <div class="ct-sidebar-alert ct-alert-warning">
            <div class="ct-sidebar-alert-title">📉 Might Be Running Low</div>
            <$list filter="[tag[CoffeeBagInstance]!tag[Finished]bag-running-low[45]]" variable="bag">
                <$let
                    remGrams={{{ [<bag>remaining-bag-weight[]] }}}
                    brewCount={{{ [tag[BrewLog]coffee-bag-instance<bag>count[]] }}}
                >
                    <div class="ct-sidebar-alert-item">
                        <$link to=<<bag>>><$view tiddler=<<bag>> field="title"/></$link>
                        <span class="ct-sidebar-alert-detail">
                            <%if [<remGrams>!is[blank]] %>(<$text text=<<remGrams>>/>g left)<%else%>(<<brewCount>> brews)<%endif%>
                        </span>
                    </div>
                </$let>
            </$list>
        </div>
    <%endif%>

    <!-- Show "No active bags" if no active bags -->
    <%if [tag[CoffeeBagInstance]!tag[Finished]count[]match[0]] %>
        <div class="ct-sidebar-alert-empty">
            <span class="ct-muted-text">No active bags ✨</span>
        </div>
    <%endif%>
</$let>
</div>

<hr>

<div class="ct-sidebar-section">
    <$link to="$:/plugins/mblackman/coffee-tracker/readme" class="ct-muted-text">❓ Help / Readme</$link>
</div>
