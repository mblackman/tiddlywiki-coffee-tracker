title: $:/plugins/mblackman/coffee-tracker/ui/dashboard
caption: Coffee Dashboard

<div class="ct-dashboard-container">

<div class="ct-dashboard-header">
    <h1 class="ct-dashboard-title">☕ Coffee Dashboard</h1>
    <div style="display: flex; align-items: center; gap: 10px;">
        <$button class="tc-btn-invisible ct-theme-button" aria-label="View coffee insights and analytics">
            <$action-navigate $to="$:/plugins/mblackman/coffee-tracker/ui/analytics"/>
            📊 Analytics
        </$button>
        <$button class="tc-btn-invisible ct-theme-button" aria-label="Browse all coffee records">
            <$action-navigate $to="$:/plugins/mblackman/coffee-tracker/ui/all-lists"/>
            📋 Browse All
        </$button>
        <div class="ct-dashboard-date">
            <$text text=<<now "DDth MMM YYYY">>/>
        </div>
    </div>
</div>

<!-- Quick Actions Toolbar -->
<div class="ct-action-toolbar">
    <$button class="tc-btn-invisible ct-btn ct-btn-primary" aria-label="Log a new brew">
        <<create-brew-log-actions>>
        ☕ + Log Brew
    </$button>
    <$button class="tc-btn-invisible ct-btn ct-btn-secondary" aria-label="Purchase a coffee bag">
        <$action-setfield $tiddler="$:/temp/new-coffee-bag-instance" purchase-date=<<now 'YYYY-0MM-0DD'>>/>
        <$action-sendmessage $message="tm-modal" $param="$:/plugins/mblackman/coffee-tracker/modal/coffee-bag-instance"/>
        📦 + Purchase Bag
    </$button>
    <$button class="tc-btn-invisible ct-btn ct-btn-secondary" aria-label="Add a new coffee type">
        <$action-sendmessage $message="tm-modal" $param="$:/plugins/mblackman/coffee-tracker/modal/coffee-bag"/>
        🌱 + Coffee Type
    </$button>
    <$button class="tc-btn-invisible ct-btn ct-btn-secondary" aria-label="Add a new roaster">
        <$action-sendmessage $message="tm-modal" $param="$:/plugins/mblackman/coffee-tracker/modal/roaster"/>
        🏪 + Roaster
    </$button>
    <$button class="tc-btn-invisible ct-btn ct-btn-secondary" aria-label="Add new equipment">
        <$action-sendmessage $message="tm-modal" $param="$:/plugins/mblackman/coffee-tracker/modal/equipment"/>
        ⚙️ + Equipment
    </$button>
</div>

<!-- Statistics Overview -->
<$let
    total-brews={{{ [tag[BrewLog]count[]] }}}
    active-bags={{{ [tag[CoffeeBagInstance]!tag[Finished]count[]] }}}
    total-coffee-types={{{ [tag[CoffeeBag]count[]] }}}
    avg-rating={{{ [tag[BrewLog]get[overall-rating]!is[blank]] :and[average[]compare:number:gt[0]fixed[1]] }}}
>
<div class="ct-stats-grid">
    <div class="ct-stat-card">
        <div class="ct-stat-value"><$text text=<<total-brews>>/></div>
        <div class="ct-stat-label">Total Brews</div>
    </div>
    <div class="ct-stat-card">
        <div class="ct-stat-value"><$text text=<<active-bags>>/></div>
        <div class="ct-stat-label">Active Bags</div>
    </div>
    <div class="ct-stat-card">
        <div class="ct-stat-value"><$text text=<<total-coffee-types>>/></div>
        <div class="ct-stat-label">Coffee Types</div>
    </div>
    <%if [<avg-rating>!is[blank]] %>
        <div class="ct-stat-card">
            <div class="ct-stat-value"><$text text=<<avg-rating>>/> /10</div>
            <div class="ct-stat-label">Avg Rating</div>
        </div>
    <%endif%>
</div>
</$let>

<div class="ct-dashboard-grid">

    <!-- Left Column: Active Bags -->
    <div>
        <div class="ct-flex-row ct-mb-md">
            <h2 class="ct-section-title ct-section-title-clean">Active Coffee</h2>
            <$button class="tc-btn-invisible ct-link ct-text-sm" aria-label="View all active coffee bags">
                <$action-navigate $to="$:/plugins/mblackman/coffee-tracker/ui/all-lists"/>
                View All →
            </$button>
        </div>

        <$list filter="[tag[CoffeeBagInstance]!tag[Finished]!sort[purchase-date]limit[5]]" emptyMessage="<div class='ct-empty-state'><div class='ct-empty-state-icon'>📦</div><div class='ct-empty-state-text'>No active coffee bags</div><div class='ct-mt-sm'><$button class='tc-btn-invisible ct-btn ct-btn-primary'><$action-setfield $tiddler='$:/temp/new-coffee-bag-instance' purchase-date=<<now 'YYYY-0MM-0DD'>>/><$action-sendmessage $message='tm-modal' $param='$:/plugins/mblackman/coffee-tracker/modal/coffee-bag-instance'/>+ Purchase Coffee</$button></div></div>">
        <div class="ct-card">
            <div class="ct-card-header">
                <h3 class="ct-card-title"><$link to=<<currentTiddler>>><$view field="title"/></$link></h3>
                <%if [all[current]has[roast-date]] [all[current]tag[Frozen]] +[limit[1]] %>
                    <$macrocall $name="coffee-freshness-badge" roastDate={{!!roast-date}} bag=<<currentTiddler>>/>
                <%endif%>
            </div>
            <div class="ct-card-subtitle">
                <$link to={{!!coffee-bag}}><$view field="coffee-bag"/></$link>
                <$let
                    brewCount={{{ [tag[BrewLog]coffee-bag-instance<currentTiddler>count[]] }}}
                    remGrams={{{ [all[current]remaining-bag-weight[]] }}}
                >
                    • <$text text=<<brewCount>>/> brews
                    <%if [<remGrams>!is[blank]] %>
                        • <strong><$text text=<<remGrams>>/>g</strong> left
                    <%endif%>
                </$let>
            </div>

            <$let
                lastBagBrew={{{ [ct.bag-last-brew<currentTiddler>] }}}
                bestBagBrew={{{ [all[current]bag-best-brew[]] }}}
            >
                <div style="display: flex; gap: 8px;">
                    <$button class="tc-btn-invisible ct-card-action-btn ct-flex-1" aria-label="Log new brew for this coffee bag">
                        <$macrocall $name="create-brew-log-actions" coffee-bag-instance=<<currentTiddler>>/>
                        ☕ Log Brew
                    </$button>
                    <%if [<bestBagBrew>!is[blank]!match<lastBagBrew>] %>
                        <$button class="tc-btn-invisible ct-card-action-btn ct-flex-1" aria-label="Log brew using best settings for this coffee bag">
                            <$macrocall $name="create-brew-log-from-last" lastBrew=<<bestBagBrew>>/>
                            ⭐ Brew Best
                        </$button>
                    <%endif%>
                    <%if [<lastBagBrew>!is[blank]] %>
                        <$button class="tc-btn-invisible ct-card-action-btn ct-flex-1" aria-label="Repeat last brew for this coffee bag">
                            <$macrocall $name="create-brew-log-from-last" lastBrew=<<lastBagBrew>>/>
                            ⚡ Brew Again
                        </$button>
                    <%endif%>
                </div>
            </$let>
        </div>
        </$list>
    </div>

    <!-- Right Column: Recent Activity -->
    <div>
        <div class="ct-flex-row ct-mb-md">
            <h2 class="ct-section-title ct-section-title-clean">Recent Brews</h2>
        </div>

        <$list filter="[tag[BrewLog]sort[created]sort[brew-time]!sort[brew-date]limit[5]]" emptyMessage="<div class='ct-empty-state'><div class='ct-empty-state-icon'>☕</div><div class='ct-empty-state-text'>No brews logged yet</div><div class='ct-mt-sm'><$button class='tc-btn-invisible ct-btn ct-btn-primary'><<create-brew-log-actions>>☕ Log Your First Brew</$button></div></div>">
            <div class="ct-card ct-flex-row">
                <div class="ct-flex-1">
                    <div class="ct-text-bold ct-mb-xs">
                        <$link to=<<currentTiddler>>>
                            <$text text={{{ [{!!brew-date}split[-]join[]format:date[DDth MMM]] }}}/>
                            <%if [all[current]has[brew-time]] %> ({{!!brew-time}})<%endif%>
                        </$link>
                    </div>
                    <div class="ct-card-subtitle ct-m-0">
                        <$link to={{!!coffee-bag-instance}}><$view field="coffee-bag-instance"/></$link>
                    </div>
                    <div class="ct-card-subtitle ct-m-0">
                        {{!!brew-method}}
                        <%if [all[current]has[dose]] %>
                            • {{!!dose}}g → <$text text={{{ [{!!water}!is[blank]addsuffix[g]] ~[{!!yield}!is[blank]addsuffix[g]] ~[[—]] }}}/>
                        <%endif%>
                    </div>
                </div>
                <div class="ct-text-lg ct-text-bold ct-pl-md ct-text-primary">
                    <$text text={{{ [{!!overall-rating}!is[blank]else[—]] }}}/>
                </div>
            </div>
        </$list>

        <!-- Quick Stats -->
        <div class="ct-quick-stats">
            <h3 class="ct-quick-stats-title">Quick Stats</h3>
            <$let
                total-roasters={{{ [tag[Roaster]count[]] }}}
                total-equipment={{{ [tag[Equipment]count[]] }}}
                finished-bags={{{ [tag[CoffeeBagInstance]tag[Finished]count[]] }}}
            >
            <div class="ct-quick-stats-grid">
                <div>
                    <div class="ct-quick-stat-value"><$text text=<<total-roasters>>/></div>
                    <div class="ct-quick-stat-label">Roasters</div>
                </div>
                <div>
                    <div class="ct-quick-stat-value"><$text text=<<total-equipment>>/></div>
                    <div class="ct-quick-stat-label">Equipment</div>
                </div>
                <div>
                    <div class="ct-quick-stat-value"><$text text=<<finished-bags>>/></div>
                    <div class="ct-quick-stat-label">Finished Bags</div>
                </div>
                <div>
                    <$button class="tc-btn-invisible ct-theme-button" style="width: 100%; text-align: center;" aria-label="Browse all coffee records">
                        <$action-navigate $to="$:/plugins/mblackman/coffee-tracker/ui/all-lists"/>
                        Browse All
                    </$button>
                </div>
            </div>
            </$let>
        </div>
    </div>

</div>
</div>
