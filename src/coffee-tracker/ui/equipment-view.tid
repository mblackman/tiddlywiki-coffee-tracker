title: $:/plugins/mblackman/coffee-tracker/ui/equipment/view
tags: $:/tags/ViewTemplate
type: text/vnd.tiddlywiki

<$list filter="[all[current]tag[Equipment]]">
<$let editState={{{ [[$:/state/coffee-tracker/edit/]addsuffix<currentTiddler>] }}}>
    <div class="ct-flex-row ct-mb-md">
        <span class="ct-status-pill">⚙️ <$view field="equipment-type">Equipment</$view></span>
        <%if [<editState>get[text]match[yes]] %>
            <$button class="tc-btn-invisible ct-btn ct-btn-primary" aria-label="Finish editing equipment details">
                <$action-deletetiddler $tiddler=<<editState>>/>
                ✓ Done
            </$button>
        <%else%>
            <$button class="tc-btn-invisible ct-btn ct-btn-secondary" aria-label="Edit equipment details">
                <$action-setfield $tiddler=<<editState>> text="yes"/>
                ✏️ Edit
            </$button>
        <%endif%>
    </div>

    <%if [<editState>get[text]match[yes]] %>
        <div class="ct-info-box ct-mb-md">
            <div class="ct-setup-grid ct-mb-sm">
                <div>
                    <label class="ct-label">Equipment Name</label>
                    <$edit-text field="equipment-name" class="tc-edit-texteditor ct-input"/>
                </div>
                <div>
                    <label class="ct-label">Type</label>
                    <$select field="equipment-type" class="tc-edit-texteditor ct-input">
                        <option value="Brewer">Brewer</option>
                        <option value="Grinder">Grinder</option>
                        <option value="Scale">Scale</option>
                        <option value="Kettle">Kettle</option>
                        <option value="Other">Other</option>
                    </$select>
                </div>
            </div>
            <div>
                <label class="ct-label">Manufacturer</label>
                <$edit-text field="equipment-manufacturer" class="tc-edit-texteditor ct-input"/>
            </div>
        </div>
    <%else%>
        <div class="ct-grid-2col ct-info-box ct-mb-md">
            <div><strong>Type:</strong> <$view field="equipment-type"><em class="ct-muted-text">—</em></$view></div>
            <div><strong>Manufacturer:</strong> <$view field="equipment-manufacturer"><em class="ct-muted-text">—</em></$view></div>
        </div>
    <%endif%>

    <%if [all[current]equipment-type[Brewer]] %>
        <$let
            brew-count={{{ [tag[BrewLog]brewer<currentTiddler>count[]] }}}
            avg-rating={{{ [tag[BrewLog]brewer<currentTiddler>get[overall-rating]!is[blank]] :and[average[]compare:number:gt[0]fixed[1]] }}}
        >
        <div class="ct-stats-grid">
            <div class="ct-stat-card">
                <div class="ct-stat-value"><$text text=<<brew-count>>/></div>
                <div class="ct-stat-label">Total Brews</div>
            </div>
            <%if [<avg-rating>!is[blank]] %>
                <div class="ct-stat-card">
                    <div class="ct-stat-value"><$text text=<<avg-rating>>/> /10</div>
                    <div class="ct-stat-label">Avg Rating</div>
                </div>
            <%endif%>
        </div>
        </$let>
    <%endif%>

    <%if [all[current]equipment-type[Grinder]] %>
        <$let
            currentGrinder=<<currentTiddler>>
            brew-count={{{ [tag[BrewLog]grinder<currentTiddler>count[]] }}}
            avg-rating={{{ [tag[BrewLog]grinder<currentTiddler>get[overall-rating]!is[blank]] :and[average[]compare:number:gt[0]fixed[1]] }}}
            total-ground={{{ [ct.grinder-total-display<currentTiddler>] }}}
        >
        <div class="ct-stats-grid">
            <div class="ct-stat-card">
                <div class="ct-stat-value"><$text text=<<brew-count>>/></div>
                <div class="ct-stat-label">Total Brews</div>
            </div>
            <div class="ct-stat-card">
                <div class="ct-stat-value"><$text text=<<total-ground>>/></div>
                <div class="ct-stat-label">Total Ground</div>
            </div>
            <%if [<avg-rating>!is[blank]] %>
                <div class="ct-stat-card">
                    <div class="ct-stat-value"><$text text=<<avg-rating>>/> /10</div>
                    <div class="ct-stat-label">Avg Rating</div>
                </div>
            <%endif%>
        </div>

        <%if [tag[BrewLog]grinder<currentGrinder>has[grind-size]has[brewer]limit[1]] %>
            <div class="ct-section-white ct-mb-md">
                <h3 class="ct-section-header">⚙️ Dial-In Grind Setting Matrix</h3>
                <div class="ct-table-wrapper">
                    <table class="ct-table">
                        <thead>
                            <tr class="ct-table-header">
                                <th>Brewer</th>
                                <th>Brews</th>
                                <th>Grind Range</th>
                                <th>Best Grind Setting</th>
                                <th>Reference Coffee / Profile</th>
                            </tr>
                        </thead>
                        <tbody>
                            <$list filter="[tag[BrewLog]grinder<currentGrinder>has[grind-size]get[brewer]!is[blank]unique[]sort[]]" variable="brewerItem">
                                <$let
                                    methodCount={{{ [tag[BrewLog]grinder<currentGrinder>brewer<brewerItem>has[grind-size]count[]] }}}
                                    grindRange={{{ [<currentGrinder>grinder-brewer-range<brewerItem>] }}}
                                    bestBrew={{{ [<currentGrinder>grinder-brewer-best<brewerItem>] }}}
                                    bestGrind={{{ [<bestBrew>get[grind-size]] }}}
                                    bestRating={{{ [<bestBrew>get[overall-rating]] }}}
                                    bestBagInstance={{{ [<bestBrew>get[coffee-bag-instance]] }}}
                                    bestCoffeeType={{{ [<bestBagInstance>get[coffee-bag]] }}}
                                    bestRoast={{{ [<bestCoffeeType>get[coffee-roast-level]] }}}
                                    bestProcess={{{ [<bestCoffeeType>get[coffee-processing]] }}}
                                >
                                    <tr>
                                        <td><strong><$link to=<<brewerItem>>><$view tiddler=<<brewerItem>> field="title"/></$link></strong></td>
                                        <td><$text text=<<methodCount>>/></td>
                                        <td><span class="ct-tag"><$text text=<<grindRange>>/></span></td>
                                        <td>
                                            <%if [<bestBrew>!is[blank]] %>
                                                <strong><$text text=<<bestGrind>>/></strong>
                                                <%if [<bestRating>!is[blank]] %>
                                                    <span class="ct-text-sm ct-text-primary"> (★ <$link to=<<bestBrew>>><$text text=<<bestRating>>/>/10</$link>)</span>
                                                <%endif%>
                                            <%else%>
                                                —
                                            <%endif%>
                                        </td>
                                        <td class="ct-text-sm ct-muted-text">
                                            <%if [<bestCoffeeType>!is[blank]] %>
                                                <$link to=<<bestCoffeeType>>><$view tiddler=<<bestCoffeeType>> field="title"/></$link>
                                                <%if [<bestRoast>!is[blank]] [<bestProcess>!is[blank]] +[limit[1]] %>
                                                    (<$text text={{{ [<bestRoast>!is[blank]] [<bestProcess>!is[blank]] +[join[ • ]] }}}/>)
                                                <%endif%>
                                            <%else%>
                                                —
                                            <%endif%>
                                        </td>
                                    </tr>
                                </$let>
                            </$list>
                        </tbody>
                    </table>
                </div>
            </div>
        <%endif%>
        </$let>
    <%endif%>

    <div class="ct-section-margin">
        <label class="ct-label">My Notes</label>
        <$edit-text field="my-notes" class="tc-edit-texteditor ct-textarea" min-height="60px" placeholder="Record grind ranges, filter papers, maintenance notes..."/>
    </div>

    <%if [all[current]equipment-type[Brewer]] %>
        <hr>

        <h3>Supported Methods</h3>

        <div class="ct-brew-methods-container">
            <$list filter="[list[!!brew-methods]]" variable="method">
                <span class="ct-brew-method-badge">
                    <$text text=<<method>>/>
                    <$button class="ct-brew-method-remove" tooltip="Remove method" aria-label={{{ [<method>addprefix[Remove brew method: ]] }}}>
                        <$action-listops $tiddler=<<currentTiddler>> $field="brew-methods" $subfilter="-[<method>]"/>
                        ×
                    </$button>
                </span>
            </$list>
            <%if [list[!!brew-methods]count[]compare:eq[0]] %>
                <em class="ct-muted-text">No methods added yet</em>
            <%endif%>
        </div>

        <div class="ct-section-margin">
            <strong>Add Method:</strong>
            <div style="margin-top: 8px;">
                <div style="margin-bottom: 8px; display: flex; gap: 8px;">
                    <$select tiddler="$:/temp/select-method" default="" class="ct-input" style="width: auto;">
                        <option value="">-- Select method --</option>
                        <$list filter="[tag[Equipment]equipment-type[Brewer]get[brew-methods]enlist-input[]] [[$:/plugins/mblackman/coffee-tracker/configs/brew-methods]list[]] +[unique[]sort[]]" variable="method">
                            <option value=<<method>>><$text text=<<method>>/></option>
                        </$list>
                    </$select>
                    <$button class="tc-btn-invisible ct-btn ct-btn-primary" aria-label="Add selected brew method">
                        <$action-listops $tiddler=<<currentTiddler>> $field="brew-methods" $subfilter="[{$:/temp/select-method}!is[blank]]"/>
                        <$action-deletefield $tiddler="$:/temp/select-method" $field="text"/>
                        Add
                    </$button>
                </div>

                <div style="display: flex; gap: 8px; align-items: center;">
                    <$edit-text tiddler="$:/temp/custom-method" tag="input" placeholder="Enter custom method name" class="ct-input" style="width: auto;"/>
                    <$button class="tc-btn-invisible ct-btn ct-btn-secondary" aria-label="Add custom brew method">
                        <$action-listops $tiddler=<<currentTiddler>> $field="brew-methods" $subfilter="[{$:/temp/custom-method}!is[blank]]"/>
                        <$action-deletefield $tiddler="$:/temp/custom-method" $field="text"/>
                        Add Custom
                    </$button>
                </div>
            </div>
        </div>
    <%endif%>

    <!-- Recent Brews Using This Equipment -->
    <%if [all[current]equipment-type[Brewer]] [all[current]equipment-type[Grinder]] +[limit[1]] %>
        <hr>
        <h3>Recent Brews</h3>
        <div class="ct-table-wrapper">
            <table class="ct-table">
                <thead>
                    <tr class="ct-table-header">
                        <th>Date</th>
                        <th>Coffee Bag</th>
                        <th>Grind</th>
                        <th>Rating</th>
                    </tr>
                </thead>
                <tbody>
                    <$list filter="[tag[BrewLog]brewer<currentTiddler>] [tag[BrewLog]grinder<currentTiddler>] +[unique[]sort[created]sort[brew-time]!sort[brew-date]limit[10]]" emptyMessage="<tr><td colspan='4' style='padding: 15px; text-align: center;' class='ct-muted-text'>No brews recorded with this equipment yet</td></tr>">
                        <tr>
                            <td><$link to=<<currentTiddler>>><$view field="brew-date"/></$link></td>
                            <td><$link to={{!!coffee-bag-instance}}><$view field="coffee-bag-instance"/></$link></td>
                            <td><$text text={{{ [{!!grind-size}!is[blank]else[—]] }}}/></td>
                            <td class="ct-text-bold"><$text text={{{ [{!!overall-rating}!is[blank]addsuffix[/10]else[—]] }}}/></td>
                        </tr>
                    </$list>
                </tbody>
            </table>
        </div>
    <%endif%>
</$let>
</$list>
