title: $:/plugins/mblackman/coffee-tracker/ui/roaster/view
tags: $:/tags/ViewTemplate
type: text/vnd.tiddlywiki

<$list filter="[all[current]tag[Roaster]]">
<$let editState={{{ [[$:/state/coffee-tracker/edit/]addsuffix<currentTiddler>] }}}>
    <div class="ct-flex-row ct-mb-md">
        <h2 class="ct-m-0"><$view field="roaster-name"><$view field="title"/></$view></h2>
        <$list filter="[<editState>get[text]!match[yes]]" variable="ignore">
            <$button class="tc-btn-invisible ct-btn ct-btn-secondary" aria-label="Edit roaster details">
                <$action-setfield $tiddler=<<editState>> text="yes"/>
                ✏️ Edit
            </$button>
        </$list>
        <$list filter="[<editState>get[text]match[yes]]" variable="ignore">
            <$button class="tc-btn-invisible ct-btn ct-btn-primary" aria-label="Finish editing roaster details">
                <$action-deletetiddler $tiddler=<<editState>>/>
                ✓ Done
            </$button>
        </$list>
    </div>

    <$list filter="[<editState>get[text]!match[yes]]" variable="ignore">
        <div class="ct-grid-2col ct-info-box ct-mb-md">
            <div><strong>Location:</strong> <$view field="roaster-location"><em class="ct-muted-text">—</em></$view></div>
            <div>
                <strong>Website:</strong>
                <$list filter="[all[current]has[roaster-website]]" variable="ignore" emptyMessage="<em class='ct-muted-text'>—</em>">
                    <a href={{!!roaster-website}} target="_blank" rel="noopener noreferrer" class="ct-link">Visit Website ↗</a>
                </$list>
            </div>
        </div>

        <$list filter="[all[current]has[my-notes]]" variable="ignore">
            <div class="ct-section-margin">
                <strong>Notes:</strong>
                <div class="ct-text-box">
                    <$view field="my-notes"/>
                </div>
            </div>
        </$list>
    </$list>

    <$list filter="[<editState>get[text]match[yes]]" variable="ignore">
        <div class="ct-info-box ct-mb-md">
            <div class="ct-setup-grid ct-mb-sm">
                <div>
                    <label class="ct-label">Roaster Name</label>
                    <$edit-text field="roaster-name" class="tc-edit-texteditor ct-input"/>
                </div>
                <div>
                    <label class="ct-label">Location</label>
                    <$edit-text field="roaster-location" placeholder="e.g. Oakland, CA" class="tc-edit-texteditor ct-input"/>
                </div>
            </div>
            <div class="ct-mb-sm">
                <label class="ct-label">Website</label>
                <$edit-text field="roaster-website" placeholder="https://" class="tc-edit-texteditor ct-input"/>
            </div>
            <div>
                <label class="ct-label">Notes</label>
                <$edit-text field="my-notes" placeholder="Notes about this roaster..." class="tc-edit-texteditor ct-textarea" min-height="70px"/>
            </div>
        </div>
    </$list>

    <hr>

    <h3>Coffee Types</h3>
    <$button class="tc-btn-invisible ct-btn ct-btn-primary ct-w-full ct-mb-md" aria-label="Add a new coffee type from this roaster">
        <$action-setfield $tiddler="$:/temp/new-coffee-bag" roaster=<<currentTiddler>>/>
        <$action-sendmessage $message="tm-modal" $param="$:/plugins/mblackman/coffee-tracker/modal/coffee-bag"/>
        + Add Coffee Type
    </$button>

    <$list filter="[tag[CoffeeBag]roaster<currentTiddler>sort[title]]" emptyMessage="<div class='ct-empty-state'>No coffee types added yet</div>">
        <div class="ct-card">
            <div class="ct-flex-row">
                <div>
                    <$link to=<<currentTiddler>> class="ct-text-bold" style="font-size: 1.1em;"><$view field="coffee-name"><$view field="title"/></$view></$link>
                    <div class="ct-card-subtitle ct-m-0">
                        <$view field="coffee-origin"/> • <$view field="coffee-roast-level"/> • <$view field="coffee-processing"/>
                    </div>
                </div>
                <$let bag-count={{{ [tag[CoffeeBagInstance]coffee-bag<currentTiddler>count[]] }}}>
                    <span class="ct-tag"><$text text=<<bag-count>>/> bags</span>
                </$let>
            </div>
        </div>
    </$list>
</$let>
</$list>
