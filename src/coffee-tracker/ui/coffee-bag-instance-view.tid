title: $:/plugins/mblackman/coffee-tracker/ui/coffee-bag-instance/view
tags: $:/tags/ViewTemplate
type: text/vnd.tiddlywiki

<$list filter="[all[current]tag[CoffeeBagInstance]]">
<$let
    currentBag=<<currentTiddler>>
    coffeeType={{!!coffee-bag}}
    roaster={{{ [<coffeeType>!is[blank]get[roaster]] }}}
    origin={{{ [<coffeeType>!is[blank]get[coffee-origin]] }}}
    roastLevel={{{ [<coffeeType>!is[blank]get[coffee-roast-level]] }}}
    processing={{{ [<coffeeType>!is[blank]get[coffee-processing]] }}}
    varietal={{{ [<coffeeType>!is[blank]get[coffee-varietal]] }}}
    editState={{{ [[$:/state/coffee-tracker/edit/]addsuffix<currentTiddler>] }}}
    calibrateState={{{ [[$:/temp/coffee-tracker/calibrate-weight/]addsuffix<currentTiddler>] }}}
>
    <div class="ct-mode-bar ct-mb-md">
        <div>
            <h3 style="margin: 0 0 5px 0;">Bag of <$link to={{!!coffee-bag}}>{{!!coffee-bag}}</$link></h3>
            <%if [<roaster>!is[blank]] [<origin>!is[blank]] [<roastLevel>!is[blank]] [<processing>!is[blank]] +[limit[1]] %>
                <div class="ct-bean-meta-row ct-mb-xs">
                    <%if [<roaster>!is[blank]] %><span class="ct-meta-badge">🏪 <$link to=<<roaster>>><$view tiddler=<<roaster>> field="roaster-name"><$text text=<<roaster>>/></$view></$link></span><%endif%>
                    <%if [<origin>!is[blank]] %><span class="ct-meta-badge">🌍 <$text text=<<origin>>/></span><%endif%>
                    <%if [<processing>!is[blank]] %><span class="ct-meta-badge"><$text text=<<processing>>/></span><%endif%>
                    <%if [<roastLevel>!is[blank]] %><span class="ct-meta-badge">🔥 <$text text=<<roastLevel>>/></span><%endif%>
                    <%if [<varietal>!is[blank]] %><span class="ct-meta-badge">🌱 <$text text=<<varietal>>/></span><%endif%>
                </div>
            <%endif%>
            <$macrocall $name="ct-tasting-note-pills" coffeeBag=<<coffeeType>> limit="8"/>
            <div style="display: flex; gap: 6px; align-items: center; margin-top: 4px;">
                <%if [all[current]tag[Finished]] %>
                    <span class="ct-tag ct-badge-danger">FINISHED</span>
                <%endif%>
                <%if [all[current]tag[Frozen]] %>
                    <span class="ct-tag ct-badge-frozen">❄️ FROZEN</span>
                <%endif%>
            </div>
        </div>
        <div class="ct-mode-actions">
            <%if [<editState>get[text]match[yes]] %>
                <$button class="tc-btn-invisible ct-btn ct-btn-primary ct-btn-sm" aria-label="Finish editing bag details">
                    <$action-deletetiddler $tiddler=<<editState>>/>
                    ✓ Done
                </$button>
            <%else%>
                <$button class="tc-btn-invisible ct-btn ct-btn-secondary ct-btn-sm" aria-label="Edit bag details">
                    <$action-setfield $tiddler=<<editState>> text="yes"/>
                    ✏️ Edit
                </$button>
            <%endif%>

            <%if [all[current]!tag[Finished]] %>
                <%if [all[current]!tag[Frozen]] %>
                    <$button class="tc-btn-invisible ct-btn ct-btn-secondary ct-btn-sm" aria-label="Freeze this coffee bag to pause aging">
                        <$action-listops $tags="+[append[Frozen]]"/>
                        <$action-setfield frozen-date=<<now "YYYY-0MM-0DD">>/>
                        ❄️ Freeze Bag
                    </$button>
                <%else%>
                    <$button class="tc-btn-invisible ct-btn ct-btn-primary ct-btn-sm" aria-label="Unfreeze this coffee bag and resume aging">
                        <$macrocall $name="unfreeze-coffee-bag-actions" bag=<<currentTiddler>>/>
                        🔥 Unfreeze Bag
                    </$button>
                <%endif%>

                <$button class="tc-btn-invisible ct-btn ct-btn-secondary ct-btn-sm" aria-label="Mark this coffee bag as finished">
                    <$macrocall $name="finish-coffee-bag-actions" bag=<<currentTiddler>>/>
                    ✓ Mark Finished
                </$button>
            <%else%>
                <$button class="tc-btn-invisible ct-btn ct-btn-primary ct-btn-sm" aria-label="Mark this coffee bag as active again">
                    <$action-listops $tags="-Finished"/>
                    ↺ Reopen Bag
                </$button>
            <%endif%>
        </div>
    </div>

    <$let costPer100g={{{ [all[current]bag-cost-per-100g[]] }}}>
    <%if [<editState>get[text]match[yes]] %>
        <div class="ct-info-box ct-mb-md">
            <div class="ct-setup-grid ct-mb-sm">
                <div>
                    <label class="ct-label">Coffee Type</label>
                    <$select field="coffee-bag" class="tc-edit-texteditor ct-input">
                        <option value="">-- Select Coffee --</option>
                        <$list filter="[tag[CoffeeBag]sort[title]]" variable="coffeeType">
                            <option value=<<coffeeType>>><$view tiddler=<<coffeeType>> field="coffee-name"><$view tiddler=<<coffeeType>> field="title"/></$view></option>
                        </$list>
                    </$select>
                </div>
                <div>
                    <label class="ct-label">Cost</label>
                    <$edit-text field="cost" placeholder="$20.00" class="tc-edit-texteditor ct-input"/>
                </div>
            </div>
            <div class="ct-setup-grid ct-mb-sm">
                <div>
                    <label class="ct-label">Purchase Date</label>
                    <$edit-text field="purchase-date" type="date" class="tc-edit-texteditor ct-input"/>
                </div>
                <div>
                    <label class="ct-label">Roast Date</label>
                    <$edit-text field="roast-date" type="date" class="tc-edit-texteditor ct-input"/>
                </div>
            </div>
            <div>
                <label class="ct-label">Initial Weight (g)</label>
                <$edit-text field="weight" inputmode="decimal" placeholder="e.g. 340g" class="tc-edit-texteditor ct-input"/>
            </div>
        </div>
    <%else%>
        <div class="ct-grid-2col ct-info-box ct-mb-md">
            <div>
                <strong>Purchase Date:</strong> <$view field="purchase-date"><em class="ct-muted-text">—</em></$view>
            </div>
            <div>
                <strong>Roast Date:</strong> <$view field="roast-date"><em class="ct-muted-text">—</em></$view>
            </div>
            <div>
                <strong>Cost:</strong> <$view field="cost"><em class="ct-muted-text">—</em></$view>
                <%if [<costPer100g>!is[blank]] %>
                    <span class="ct-muted-text ct-text-sm"> ($<$text text=<<costPer100g>>/> / 100g)</span>
                <%endif%>
            </div>
            <div>
                <strong>Initial Weight:</strong> <$view field="weight"><em class="ct-muted-text">—</em></$view>
            </div>
        </div>
    <%endif%>
    </$let>

    <!-- Remaining Weight & Usage Tracker -->
    <$let
        rawWeight={{{ [all[current]bag-raw-weight[]] }}}
        remainingGrams={{{ [all[current]remaining-bag-weight[]] }}}
        usedGrams={{{ [tag[BrewLog]coffee-bag-instance<currentTiddler>get[dose]sum[]round[]] ~[[0]] }}}
        weightAdj={{{ [{!!weight-adjustment}!is[blank]else[0]] }}}
        avgDose={{{ [tag[BrewLog]coffee-bag-instance<currentTiddler>get[dose]average[]compare:number:gt[0]] ~[[18]] }}}
        pctRaw={{{ [<remainingGrams>!is[blank]divide<rawWeight>multiply[100]round[]] }}}
        pctRemaining={{{ [<pctRaw>compare:number:gt[100]then[100]else<pctRaw>] }}}
        estBrewsLeft={{{ [<remainingGrams>!is[blank]divide<avgDose>floor[]] }}}
    >
    <%if [<remainingGrams>!is[blank]] %>
        <div class="ct-info-box ct-mb-md">
            <div class="ct-reference-header">
                <span>
                    <strong>Remaining Coffee:</strong>
                    <span class="ct-emphasis-text"><$text text=<<remainingGrams>>/>g</span>
                    <span class="ct-muted-text">
                        / <$text text=<<rawWeight>>/>g (<$text text=<<usedGrams>>/>g brewed<%if [<weightAdj>!match[0]] %>, <$text text={{{ [<weightAdj>compare:number:gt[0]then[+]addsuffix<weightAdj>else<weightAdj>] }}}/>g adjusted<%endif%>)
                    </span>
                </span>
                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                    <%if [all[current]!tag[Finished]] %>
                        <span class="ct-text-sm ct-muted-text">
                            ~<$text text=<<estBrewsLeft>>/> brews left
                        </span>
                    <%endif%>
                    <%if [<calibrateState>!is[tiddler]] %>
                        <$button class="tc-btn-invisible ct-btn ct-btn-secondary ct-btn-sm" aria-label="Set actual remaining weight from scale">
                            <$action-setfield $tiddler=<<calibrateState>> text=<<remainingGrams>>/>
                            ⚖️ Set Actual Weight
                        </$button>
                    <%endif%>
                </div>
            </div>

            <%if [<calibrateState>is[tiddler]] %>
                <div class="ct-calibrate-row ct-mt-sm">
                    <span class="ct-text-sm"><strong>Scale remaining weight (g):</strong></span>
                    <$edit-text tiddler=<<calibrateState>> field="text" tag="input" inputmode="decimal" size="6" class="tc-edit-texteditor ct-input" style="width: 90px; padding: 6px 10px;"/>
                    <$let
                        enteredWeight={{{ [<calibrateState>get[text]trim[]] }}}
                        expectedUnadjusted={{{ [<rawWeight>subtract<usedGrams>] }}}
                        computedAdj={{{ [<enteredWeight>regexp[^\d+(\.\d+)?$]subtract<expectedUnadjusted>round[]] }}}
                    >
                    <$button class="tc-btn-invisible ct-btn ct-btn-primary ct-btn-sm" disabled={{{ [<computedAdj>is[blank]then[yes]else[no]] }}} aria-label="Save calibrated remaining weight">
                        <$action-setfield $tiddler=<<currentBag>> weight-adjustment=<<computedAdj>>/>
                        <$action-deletetiddler $tiddler=<<calibrateState>>/>
                        ✓ Save
                    </$button>
                    </$let>
                    <%if [<weightAdj>!match[0]] %>
                        <$button class="tc-btn-invisible ct-btn ct-btn-secondary ct-btn-sm" aria-label="Reset manual weight adjustment">
                            <$action-deletefield $tiddler=<<currentBag>> $field="weight-adjustment"/>
                            <$action-deletetiddler $tiddler=<<calibrateState>>/>
                            ↺ Reset Offset
                        </$button>
                    <%endif%>
                    <$button class="tc-btn-invisible ct-btn ct-btn-secondary ct-btn-sm" aria-label="Cancel weight calibration">
                        <$action-deletetiddler $tiddler=<<calibrateState>>/>
                        Cancel
                    </$button>
                </div>
            <%endif%>

            <div class="ct-progress-bar">
                <div class="ct-progress-fill" style=`width: $(pctRemaining)$%;`/>
            </div>

            <%if [all[current]!tag[Finished]] :filter[<remainingGrams>compare:number:lteq[0]] %>
                <div class="ct-reference-header ct-mt-sm">
                    <span class="ct-text-sm ct-text-warning">Looks like this bag is empty!</span>
                    <$button class="tc-btn-invisible ct-btn ct-btn-primary ct-btn-sm">
                        <$macrocall $name="finish-coffee-bag-actions" bag=<<currentTiddler>>/>
                        Mark Bag as Finished
                    </$button>
                </div>
            <%endif%>
        </div>
    <%endif%>
    </$let>

    <!-- Freshness Banner (only shown while bag is active) -->
    <%if [all[current]!tag[Finished]has[roast-date]] %>
        <$let
            roast-days={{{ [all[current]days-since-roast[roast-date]] }}}
            peak-start={{$:/plugins/mblackman/coffee-tracker/config/freshness/peak-start}}
            peak-end={{$:/plugins/mblackman/coffee-tracker/config/freshness/peak-end}}
            optimal-end={{$:/plugins/mblackman/coffee-tracker/config/freshness/optimal-end}}
        >
        <%if [<roast-days>!is[blank]] %>
            <div class="ct-highlight-box">
                <%if [all[current]tag[Frozen]] %>
                    <strong>❄️ Stored in Freezer:</strong> Roast age paused at <span class="ct-emphasis-text"><$text text=<<roast-days>>/> days</span>
                    <%if [all[current]has[frozen-date]] %>
                        <span class="ct-muted-text" style="margin-left: 8px;">(frozen since <$view field="frozen-date"/>)</span>
                    <%endif%>
                <%else%>
                    <strong>Days Since Roast:</strong> <span class="ct-emphasis-text"><$text text=<<roast-days>>/></span>
                    <%if [{!!frozen-days}!is[blank]!match[0]] %>
                        <span class="ct-muted-text ct-text-sm" style="margin-left: 6px;">(excludes {{!!frozen-days}}d in freezer)</span>
                    <%endif%>
                    <%if [<roast-days>compare:number:lt<peak-start>] %>
                        <span style="margin-left: 10px;" class="ct-text-primary">✓ Very fresh (degassing)</span>
                    <%elseif [<roast-days>compare:number:gteq<peak-start>compare:number:lt<peak-end>] %>
                        <span style="margin-left: 10px;" class="ct-text-primary">☕ Peak freshness!</span>
                    <%elseif [<roast-days>compare:number:gteq<peak-end>compare:number:lt<optimal-end>] %>
                        <span class="ct-muted-text" style="margin-left: 10px;">☕ Still good</span>
                    <%else%>
                        <span style="margin-left: 10px;" class="ct-text-danger">⚠ Aging</span>
                    <%endif%>
                <%endif%>
            </div>
        <%endif%>
        </$let>
    <%endif%>

    <div class="ct-section-margin">
        <label class="ct-label">My Thoughts & Dial-In Notes</label>
        <$edit-text field="my-thoughts" class="tc-edit-texteditor ct-textarea" min-height="60px" placeholder="Jot down dial-in tips, flavor evolution, or overall impressions of this bag..."/>
    </div>

    <hr>

    <h3>Brew History</h3>

    <$let
        brew-count={{{ [tag[BrewLog]coffee-bag-instance<currentTiddler>count[]] }}}
        avg-rating={{{ [ct.bag-instance-avg<currentTiddler>] }}}
        avg-brew-cost={{{ [all[current]brew-cost[]] }}}
        lastBagBrew={{{ [ct.bag-last-brew<currentTiddler>] }}}
        bestBagBrew={{{ [all[current]bag-best-brew[]] }}}
        pinnedBest={{!!best-brew}}
    >
    <div class="ct-stats-grid ct-mb-md">
        <div class="ct-stat-card">
            <div class="ct-stat-value"><$text text=<<brew-count>>/></div>
            <div class="ct-stat-label">Total Brews</div>
        </div>
        <%if [<avg-rating>!is[blank]] %>
            <div class="ct-stat-card">
                <div class="ct-stat-value"><$text text=<<avg-rating>>/> /10</div>
                <div class="ct-stat-label">Avg Rating</div>
            </div>
        <%endif%>
        <%if [<avg-brew-cost>!is[blank]] %>
            <div class="ct-stat-card">
                <div class="ct-stat-value">$<$text text=<<avg-brew-cost>>/></div>
                <div class="ct-stat-label">Avg Cost / Cup</div>
            </div>
        <%endif%>
    </div>

    <!-- Best / Reference Brew Callout -->
    <%if [<bestBagBrew>!is[blank]] %>
        <$let
            bDose={{{ [<bestBagBrew>get[dose]] }}}
            bWater={{{ [<bestBagBrew>get[water]] }}}
            bYield={{{ [<bestBagBrew>get[yield]] }}}
            bRatio={{{ [ct.water-ratio<bDose>,<bWater>] ~[ct.yield-ratio<bDose>,<bYield>] }}}
        >
        <div class="ct-reference-banner ct-mb-md">
            <div class="ct-reference-header ct-mb-xs">
                <span>
                    <%if [<pinnedBest>match<bestBagBrew>] %>
                        <strong>📌 Pinned Best Brew (<$link to=<<bestBagBrew>>><$view tiddler=<<bestBagBrew>> field="brew-date"/></$link>):</strong>
                    <%else%>
                        <strong>⭐ Best Rated Brew (<$link to=<<bestBagBrew>>><$view tiddler=<<bestBagBrew>> field="brew-date"/></$link>):</strong>
                    <%endif%>
                </span>
                <span class="ct-text-bold ct-text-primary">
                    ★ <$view tiddler=<<bestBagBrew>> field="overall-rating">—</$view>/10
                </span>
            </div>
            <div class="ct-text-sm ct-muted-text">
                Method: <strong><$view tiddler=<<bestBagBrew>> field="brew-method">—</$view></strong> •
                Dose: <strong><$view tiddler=<<bestBagBrew>> field="dose">—</$view>g</strong> •
                Water/Yield: <strong><$text text={{{ [<bestBagBrew>get[water]!is[blank]addsuffix[g]] ~[<bestBagBrew>get[yield]!is[blank]addsuffix[g]] ~[[—]] }}}/></strong><%if [<bRatio>!is[blank]] %> (<strong>1:<$text text=<<bRatio>>/></strong>)<%endif%> •
                Grind: <strong><$view tiddler=<<bestBagBrew>> field="grind-size">—</$view></strong> •
                Temp: <strong><$view tiddler=<<bestBagBrew>> field="water-temp">—</$view>°C</strong> •
                Time: <strong><$view tiddler=<<bestBagBrew>> field="brew-time-seconds">—</$view></strong>
            </div>
            <%if [<lastBagBrew>!is[blank]!match<bestBagBrew>] %>
                <div class="ct-text-sm ct-muted-text ct-mt-sm" style="border-top: 1px dashed var(--tpc-tiddler-editor-border, rgba(128,128,128,0.3)); padding-top: 6px;">
                    <strong>💡 Latest Brew (<$link to=<<lastBagBrew>>><$view tiddler=<<lastBagBrew>> field="brew-date"/></$link>):</strong>
                    <$view tiddler=<<lastBagBrew>> field="dose">—</$view>g →
                    <$text text={{{ [<lastBagBrew>get[water]!is[blank]addsuffix[g]] ~[<lastBagBrew>get[yield]!is[blank]addsuffix[g]] ~[[—]] }}}/> •
                    Grind <strong><$view tiddler=<<lastBagBrew>> field="grind-size">—</$view></strong> •
                    Temp <strong><$view tiddler=<<lastBagBrew>> field="water-temp">—</$view>°C</strong> •
                    ★ <strong><$view tiddler=<<lastBagBrew>> field="overall-rating">—</$view>/10</strong>
                </div>
            <%endif%>
        </div>
        </$let>
    <%endif%>

    <%if [<lastBagBrew>has[next-brew-adjustment]] %>
        <div class="ct-next-adjustment-callout ct-mb-md">
            <strong>🎯 Target Adjustment for Next Brew:</strong> <$view tiddler=<<lastBagBrew>> field="next-brew-adjustment"/>
        </div>
    <%endif%>

    <!-- Bag Visual Analytics (Sensory Radar & Rating Progression) -->
    <%if [<currentTiddler>sensory-radar-points[]] [<currentTiddler>bag-progression-points[]] +[limit[1]] %>
        <div class="ct-analytics-row ct-mb-md">
            <%if [<currentTiddler>sensory-radar-points[]!is[blank]] %>
                <div class="ct-info-box ct-flex-1">
                    <div class="ct-text-sm ct-text-bold ct-mb-xs" style="text-align: center;">Avg Sensory Profile</div>
                    <$ct.sensory-radar target=<<currentTiddler>>/>
                </div>
            <%endif%>
            <%if [<currentTiddler>bag-progression-points[]!is[blank]] %>
                <div class="ct-info-box ct-flex-1">
                    <$macrocall $name="ct-progression-chart" target=<<currentTiddler>> label="Bag Rating & Roast-Age Progression"/>
                </div>
            <%endif%>
        </div>
    <%endif%>

    <div class="ct-action-buttons-row ct-mb-md">
        <$button class="tc-btn-invisible ct-btn ct-btn-primary ct-flex-1" aria-label="Add new brew log for this coffee bag">
            <$macrocall $name="create-brew-log-actions" coffee-bag-instance=<<currentTiddler>>/>
            ☕ Log New Brew
        </$button>
        <%if [<bestBagBrew>!is[blank]!match<lastBagBrew>] %>
            <$button class="tc-btn-invisible ct-btn ct-btn-secondary ct-flex-1" aria-label="Log a new brew copying parameters from the best brew of this bag">
                <$macrocall $name="create-brew-log-from-last" lastBrew=<<bestBagBrew>>/>
                ⭐ Brew Best
            </$button>
        <%endif%>
        <%if [<lastBagBrew>!is[blank]] %>
            <$button class="tc-btn-invisible ct-btn ct-btn-secondary ct-flex-1" aria-label="Log a new brew copying parameters from the last brew of this bag">
                <$macrocall $name="create-brew-log-from-last" lastBrew=<<lastBagBrew>>/>
                ⚡ Brew Again (Last)
            </$button>
        <%endif%>
    </div>

    <div class="ct-table-wrapper">
        <table class="ct-table ct-table-responsive">
            <thead>
                <tr class="ct-table-header">
                    <th style="width: 44px; text-align: center;" title="Pin as Best / Reference Brew">⭐</th>
                    <th>Date / Age</th>
                    <th>Method</th>
                    <th>Recipe</th>
                    <th>Grind</th>
                    <th>Time</th>
                    <th>Rating</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
            <$list filter="[tag[BrewLog]coffee-bag-instance<currentTiddler>sort[created]sort[brew-time]!sort[brew-date]]" emptyMessage="<tr><td colspan='8' style='padding: 20px; text-align: center;' class='ct-muted-text'>No brews logged yet</td></tr>">
                <$let
                    brewAge={{{ [all[current]brew-roast-age[]] }}}
                    rDose={{!!dose}}
                    rWater={{!!water}}
                    rYield={{!!yield}}
                    rRatio={{{ [ct.water-ratio<rDose>,<rWater>] ~[ct.yield-ratio<rDose>,<rYield>] }}}
                >
                <tr class=`${ [<bestBagBrew>match<currentTiddler>then[ct-best-brew-row]else[]] }$`>
                    <td data-label="Best" style="text-align: center;">
                        <%if [<pinnedBest>match<currentTiddler>] %>
                            <$button class="tc-btn-invisible ct-pin-btn ct-pin-active" tooltip="Unpin as Best Brew" aria-label="Unpin as Best Brew">
                                <$action-deletefield $tiddler=<<currentBag>> $field="best-brew"/>
                                ⭐
                            </$button>
                        <%elseif [<bestBagBrew>match<currentTiddler>] %>
                            <$button class="tc-btn-invisible ct-pin-btn ct-pin-auto" tooltip="Auto-selected as Best Brew (click to pin explicitly)" aria-label="Pin as Best Brew">
                                <$action-setfield $tiddler=<<currentBag>> best-brew=<<currentTiddler>>/>
                                ★
                            </$button>
                        <%else%>
                            <$button class="tc-btn-invisible ct-pin-btn" tooltip="Pin as Best / Reference Brew for this bag" aria-label="Pin as Best Brew">
                                <$action-setfield $tiddler=<<currentBag>> best-brew=<<currentTiddler>>/>
                                ☆
                            </$button>
                        <%endif%>
                    </td>
                    <td data-label="Date / Age" style="white-space: nowrap;">
                        <$link to=<<currentTiddler>>><$view field="brew-date"/></$link>
                        <%if [<brewAge>!is[blank]] %>
                            <span class="ct-muted-text ct-text-sm"> (<$text text=<<brewAge>>/>d)</span>
                        <%endif%>
                    </td>
                    <td data-label="Method">{{!!brew-method}}</td>
                    <td data-label="Recipe" style="white-space: nowrap;">
                        <%if [all[current]has[dose]] %>
                            {{!!dose}}g →
                            <$text text={{{ [{!!water}!is[blank]addsuffix[g]] ~[{!!yield}!is[blank]addsuffix[g]] ~[[—]] }}}/>
                            <%if [<rRatio>!is[blank]] %>
                                <span class="ct-muted-text ct-text-sm"> (1:<$text text=<<rRatio>>/>)</span>
                            <%endif%>
                        <%endif%>
                    </td>
                    <td data-label="Grind"><$text text={{{ [{!!grind-size}!is[blank]else[—]] }}}/></td>
                    <td data-label="Time"><$text text={{{ [{!!brew-time-seconds}!is[blank]else[—]] }}}/></td>
                    <td data-label="Rating" style="font-weight: bold; white-space: nowrap;">
                        <$text text={{{ [{!!overall-rating}!is[blank]addsuffix[/10]else[—]] }}}/>
                    </td>
                    <td data-label="Notes" class="ct-text-sm ct-muted-text ct-notes-cell">
                        <%if [list[!!extraction-notes]limit[1]] %>
                            <div style="margin-bottom: 4px;">
                                <$list filter="[list[!!extraction-notes]]" variable="extTag">
                                    <span class="ct-tag" style="margin-right: 4px;"><$text text=<<extTag>>/></span>
                                </$list>
                            </div>
                        <%endif%>
                        <div>{{!!notes}}</div>
                        <%if [all[current]has[next-brew-adjustment]] %>
                            <div class="ct-text-primary"><strong>🎯 Next:</strong> {{!!next-brew-adjustment}}</div>
                        <%endif%>
                    </td>
                </tr>
                </$let>
            </$list>
            </tbody>
        </table>
    </div>
    </$let>
</$let>
</$list>
