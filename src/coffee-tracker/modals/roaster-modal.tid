title: $:/plugins/mblackman/coffee-tracker/modal/roaster
subtitle: Add New Roaster
tags: $:/tags/Modal
type: text/vnd.tiddlywiki

\define save-actions()
<$action-createtiddler
    $basetitle={{$:/temp/new-roaster!!roaster-name}}
    tags="Roaster"
    roaster-name={{$:/temp/new-roaster!!roaster-name}}
    roaster-location={{$:/temp/new-roaster!!roaster-location}}
    roaster-website={{$:/temp/new-roaster!!roaster-website}}
    my-notes={{$:/temp/new-roaster!!my-notes}}
    $savetitle="$:/temp/created-roaster"
/>
<$action-deletetiddler $tiddler="$:/temp/new-roaster"/>
<$action-sendmessage $message="tm-close-tiddler"/>
<$action-navigate $to={{$:/temp/created-roaster}}/>
<$action-deletetiddler $tiddler="$:/temp/created-roaster"/>
\end

<div class="tc-modal-body">

<div class="ct-mb-md">
    <label class="ct-label">Roaster Name *</label>
    <$edit-text tiddler="$:/temp/new-roaster" field="roaster-name" placeholder="e.g. Blue Bottle Coffee" class="tc-edit-texteditor ct-input"/>
</div>

<div class="ct-mb-md">
    <label class="ct-label">Location</label>
    <$edit-text tiddler="$:/temp/new-roaster" field="roaster-location" placeholder="e.g. Oakland, CA" class="tc-edit-texteditor ct-input"/>
</div>

<div class="ct-mb-md">
    <label class="ct-label">Website</label>
    <$edit-text tiddler="$:/temp/new-roaster" field="roaster-website" placeholder="https://" class="tc-edit-texteditor ct-input"/>
</div>

<div class="ct-mb-md">
    <label class="ct-label">Notes</label>
    <$edit-text tiddler="$:/temp/new-roaster" field="my-notes" placeholder="Specialty, shipping notes, favorite blends..." class="tc-edit-texteditor ct-textarea" min-height="70px"/>
</div>

</div>

<div class="tc-modal-footer">
    <$let isValid={{{ [{$:/temp/new-roaster!!roaster-name}trim[]!is[blank]then[yes]else[no]] }}}>
        <$button class="tc-btn-invisible ct-btn ct-btn-primary" actions=<<save-actions>> disabled={{{ [<isValid>match[no]then[yes]else[no]] }}}>
            ✓ Create Roaster
        </$button>
    </$let>
</div>
