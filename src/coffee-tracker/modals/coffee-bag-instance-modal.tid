title: $:/plugins/mblackman/coffee-tracker/modal/coffee-bag-instance
subtitle: Add New Coffee Bag
tags: $:/tags/Modal
type: text/vnd.tiddlywiki

\procedure save-actions()
<$let
    bag-name={{{ [{$:/temp/new-coffee-bag-instance!!coffee-bag}] }}}
    purchase-date={{{ [{$:/temp/new-coffee-bag-instance!!purchase-date}!is[blank]else<now "YYYY-0MM-0DD">] }}}
>
<$action-createtiddler
    $basetitle={{{ [<bag-name>addsuffix[ - ]addsuffix<purchase-date>] }}}
    tags="CoffeeBagInstance"
    coffee-bag=<<bag-name>>
    purchase-date=<<purchase-date>>
    roast-date={{$:/temp/new-coffee-bag-instance!!roast-date}}
    cost={{$:/temp/new-coffee-bag-instance!!cost}}
    weight={{$:/temp/new-coffee-bag-instance!!weight}}
    my-thoughts={{$:/temp/new-coffee-bag-instance!!my-thoughts}}
    $savetitle="$:/temp/created-coffee-bag-instance"
/>
</$let>
<$action-deletetiddler $tiddler="$:/temp/new-coffee-bag-instance"/>
<$action-sendmessage $message="tm-close-tiddler"/>
<$action-navigate $to={{$:/temp/created-coffee-bag-instance}}/>
<$action-deletetiddler $tiddler="$:/temp/created-coffee-bag-instance"/>
\end

<div class="tc-modal-body">

<div class="ct-mb-md">
    <label class="ct-label">Coffee Type *</label>
    <$select tiddler="$:/temp/new-coffee-bag-instance" field="coffee-bag" class="tc-edit-texteditor ct-input">
        <option value="">-- Select Coffee --</option>
        <$list filter="[tag[CoffeeBag]sort[title]]">
            <option value=<<currentTiddler>>><$view field="coffee-name"><$view field="title"/></$view> (<$view field="roaster"/>)</option>
        </$list>
    </$select>
    <div style="margin-top: 5px; font-size: 0.9em;" class="ct-muted-text">
        Don't see your coffee? <$button class="tc-btn-invisible ct-link" style="padding: 0; text-decoration: underline;">
            <$action-sendmessage $message="tm-close-tiddler"/>
            <$action-sendmessage $message="tm-modal" $param="$:/plugins/mblackman/coffee-tracker/modal/coffee-bag"/>
            Add a new coffee type first
        </$button>
    </div>
</div>

<div class="ct-setup-grid ct-mb-md">
    <div>
        <label class="ct-label">Purchase Date *</label>
        <$edit-text tiddler="$:/temp/new-coffee-bag-instance" field="purchase-date" type="date" default=<<now "YYYY-0MM-0DD">> class="tc-edit-texteditor ct-input"/>
    </div>

    <div>
        <label class="ct-label">Roast Date</label>
        <$edit-text tiddler="$:/temp/new-coffee-bag-instance" field="roast-date" type="date" class="tc-edit-texteditor ct-input"/>
    </div>
</div>

<div class="ct-setup-grid ct-mb-md">
    <div>
        <label class="ct-label">Cost</label>
        <$edit-text tiddler="$:/temp/new-coffee-bag-instance" field="cost" placeholder="e.g. $20.00" class="tc-edit-texteditor ct-input"/>
    </div>

    <div>
        <label class="ct-label">Weight (g)</label>
        <$edit-text tiddler="$:/temp/new-coffee-bag-instance" field="weight" placeholder="e.g. 340g" class="tc-edit-texteditor ct-input"/>
    </div>
</div>

<div class="ct-mb-md">
    <label class="ct-label">My Thoughts</label>
    <$edit-text tiddler="$:/temp/new-coffee-bag-instance" field="my-thoughts" placeholder="Initial impressions, notes..." class="tc-edit-texteditor ct-textarea" min-height="80px"/>
</div>

</div>

<div class="tc-modal-footer">
    <$let isDisabled={{{ [{$:/temp/new-coffee-bag-instance!!coffee-bag}trim[]!is[blank]then[no]else[yes]] }}}>
        <$button class="tc-btn-invisible ct-btn ct-btn-primary" actions=<<save-actions>> disabled=<<isDisabled>>>
            ✓ Purchase Bag
        </$button>
    </$let>
</div>
