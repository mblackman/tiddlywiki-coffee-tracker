title: $:/plugins/mblackman/coffee-tracker/modal/equipment
subtitle: Add New Equipment
tags: $:/tags/Modal
type: text/vnd.tiddlywiki

\procedure save-actions()
<$let
    initialMethod={{{ [{$:/temp/new-equipment!!equipment-type}match[Brewer]then{$:/temp/new-equipment!!default-brew-method}!is[blank]format:titlelist[]] }}}
>
<$action-createtiddler
    $basetitle={{$:/temp/new-equipment!!equipment-name}}
    tags="Equipment"
    equipment-name={{$:/temp/new-equipment!!equipment-name}}
    equipment-type={{$:/temp/new-equipment!!equipment-type}}
    equipment-manufacturer={{$:/temp/new-equipment!!equipment-manufacturer}}
    brew-methods=<<initialMethod>>
    my-notes={{$:/temp/new-equipment!!my-notes}}
    $savetitle="$:/temp/created-equipment"
/>
</$let>
<$action-deletetiddler $tiddler="$:/temp/new-equipment"/>
<$action-sendmessage $message="tm-close-tiddler"/>
<$action-navigate $to={{$:/temp/created-equipment}}/>
<$action-deletetiddler $tiddler="$:/temp/created-equipment"/>
\end

<div class="tc-modal-body">

<div class="ct-mb-md">
    <label class="ct-label">Equipment Name *</label>
    <$edit-text tiddler="$:/temp/new-equipment" field="equipment-name" placeholder="e.g. Hario V60" class="tc-edit-texteditor ct-input"/>
</div>

<div class="ct-setup-grid ct-mb-md">
    <div>
        <label class="ct-label">Type *</label>
        <$select tiddler="$:/temp/new-equipment" field="equipment-type" class="tc-edit-texteditor ct-input">
            <option value="">-- Select Type --</option>
            <option value="Brewer">Brewer</option>
            <option value="Grinder">Grinder</option>
            <option value="Scale">Scale</option>
            <option value="Kettle">Kettle</option>
            <option value="Other">Other</option>
        </$select>
    </div>

    <div>
        <label class="ct-label">Manufacturer</label>
        <$edit-text tiddler="$:/temp/new-equipment" field="equipment-manufacturer" placeholder="e.g. Hario" class="tc-edit-texteditor ct-input"/>
    </div>
</div>

<%if [{$:/temp/new-equipment!!equipment-type}match[Brewer]] %>
    <div class="ct-mb-md">
        <label class="ct-label">Primary Brew Method</label>
        <$select tiddler="$:/temp/new-equipment" field="default-brew-method" class="tc-edit-texteditor ct-input">
            <option value="">-- Optional: Select Primary Method --</option>
            <$list filter="[tag[Equipment]equipment-type[Brewer]get[brew-methods]enlist-input[]] [[$:/plugins/mblackman/coffee-tracker/configs/brew-methods]list[]] +[unique[]sort[]]" variable="method">
                <option value=<<method>>><$text text=<<method>>/></option>
            </$list>
        </$select>
    </div>
<%endif%>

<div class="ct-mb-md">
    <label class="ct-label">Notes</label>
    <$edit-text tiddler="$:/temp/new-equipment" field="my-notes" placeholder="Any additional notes..." class="tc-edit-texteditor ct-textarea" min-height="80px"/>
</div>

</div>

<div class="tc-modal-footer">
    <$let
        hasName={{{ [{$:/temp/new-equipment!!equipment-name}trim[]!is[blank]then[yes]else[no]] }}}
        hasType={{{ [{$:/temp/new-equipment!!equipment-type}trim[]!is[blank]then[yes]else[no]] }}}
        isDisabled={{{ [<hasName>match[yes]] [<hasType>match[yes]] +[count[]match[2]then[no]else[yes]] }}}
    >
        <$button class="tc-btn-invisible ct-btn ct-btn-primary" actions=<<save-actions>> disabled=<<isDisabled>>>
            ✓ Create Equipment
        </$button>
    </$let>
</div>
